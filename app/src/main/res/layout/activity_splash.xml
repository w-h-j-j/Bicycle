<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <!-- 渐变背景 -->
    <RelativeLayout
        android:id="@+id/splash_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/splash_gradient_bg">

        <!-- 装饰性圆环 1 - 右上角 -->
        <View
            android:id="@+id/deco_circle_1"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="-100dp"
            android:layout_marginEnd="-100dp"
            android:alpha="0.0"
            android:background="@drawable/splash_deco_circle" />

        <!-- 装饰性圆环 2 - 左下角 -->
        <View
            android:id="@+id/deco_circle_2"
            android:layout_width="350dp"
            android:layout_height="350dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_marginBottom="-180dp"
            android:layout_marginStart="-120dp"
            android:alpha="0.0"
            android:background="@drawable/splash_deco_circle" />

        <!-- 装饰线条 1 -->
        <View
            android:id="@+id/deco_line_1"
            android:layout_width="1px"
            android:layout_height="150dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="60dp"
            android:layout_marginTop="100dp"
            android:alpha="0.0"
            android:background="@drawable/splash_deco_line" />

        <!-- 装饰线条 2 -->
        <View
            android:id="@+id/deco_line_2"
            android:layout_width="1px"
            android:layout_height="120dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="80dp"
            android:layout_marginBottom="150dp"
            android:alpha="0.0"
            android:background="@drawable/splash_deco_line" />

        <!-- 中心内容 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Logo 容器 -->
            <FrameLayout
                android:id="@+id/logo_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.0">

                <!-- 光晕背景 -->
                <View
                    android:id="@+id/logo_glow"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center"
                    android:background="@drawable/splash_logo_glow" />

                <!-- Logo 图标 -->
                <ImageView
                    android:id="@+id/iv_logo"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@mipmap/ic_launcher" />

            </FrameLayout>

            <!-- 应用名称 -->
            <TextView
                android:id="@+id/tv_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:alpha="0.0"
                android:letterSpacing="0.15"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="34sp"
                android:textStyle="bold" />

            <!-- 动态分隔线 -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="3dp"
                android:layout_marginTop="20dp"
                android:alpha="0.0">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/splash_line_gradient" />

            </FrameLayout>

            <!-- 标语 -->
            <TextView
                android:id="@+id/tv_slogan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:alpha="0.0"
                android:letterSpacing="0.08"
                android:text="智能出行，从这里开始"
                android:textColor="#CCFFFFFF"
                android:textSize="15sp" />

            <!-- 加载状态文字 -->
            <TextView
                android:id="@+id/tv_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:alpha="0.0"
                android:letterSpacing="0.05"
                android:text="正在启动..."
                android:textColor="#80FFFFFF"
                android:textSize="13sp" />

            <!-- 环形进度指示器 -->
            <ProgressBar
                android:id="@+id/progress_ring"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:alpha="0.0"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/splash_progress_bar" />

            <!-- 百分比文字 -->
            <TextView
                android:id="@+id/tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:alpha="0.0"
                android:text="0%"
                android:textColor="#66FFFFFF"
                android:textSize="12sp" />

            <!-- 底部版本和版权 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.5"
                    android:text="Version 1.0.0"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.3"
                    android:text="© 2025 Bicycle Team"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</layout>