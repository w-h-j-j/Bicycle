<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient_bg">

    <!-- 装饰圆 - 左上 -->
    <View
        android:id="@+id/splash_deco_circle_1"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-40dp"
        android:layout_marginTop="-30dp"
        android:alpha="0"
        android:background="@drawable/splash_deco_circle" />

    <!-- 装饰圆 - 右下 -->
    <View
        android:id="@+id/splash_deco_circle_2"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-20dp"
        android:layout_marginBottom="-20dp"
        android:alpha="0"
        android:background="@drawable/splash_deco_circle" />

    <!-- 装饰竖线 - 左侧 -->
    <View
        android:id="@+id/splash_deco_line"
        android:layout_width="2dp"
        android:layout_height="120dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="24dp"
        android:alpha="0"
        android:background="@drawable/splash_deco_line" />

    <!-- 中心容器 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Logo 光晕 -->
        <FrameLayout
            android:id="@+id/splash_logo_container"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:alpha="0">

            <!-- 外圈光环 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="-10dp"
                android:background="@drawable/splash_logo_halo" />

            <!-- 内圈辉光 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/splash_logo_glow" />

            <!-- App 图标 -->
            <ImageView
                android:id="@+id/splash_icon"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:contentDescription="logo"
                android:src="@mipmap/icon_background" />

        </FrameLayout>

        <!-- 标题文字 -->
        <TextView
            android:id="@+id/splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:alpha="0"
            android:letterSpacing="0.15"
            android:text="BICYCLE"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- 副标题 -->
        <TextView
            android:id="@+id/splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0"
            android:letterSpacing="0.08"
            android:text="智能骑行助手"
            android:textColor="#80FFFFFF"
            android:textSize="14sp" />

        <!-- 版本号 -->
        <TextView
            android:id="@+id/splash_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:alpha="0"
            android:text="v1.0.0"
            android:textColor="#40FFFFFF"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- 底部进度条 -->
    <ProgressBar
        android:id="@+id/splash_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="60dp"
        android:alpha="0"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/splash_progress_bar" />

</FrameLayout>
