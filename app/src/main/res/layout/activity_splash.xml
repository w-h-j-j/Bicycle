<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient_bg">

    <!-- 中心内容 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Logo + 进度环 -->
        <FrameLayout
            android:id="@+id/splash_logo_container"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:alpha="0">

            <!-- 圆形进度环 -->
            <ProgressBar
                android:id="@+id/splash_ring"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/splash_ring_progress" />

            <!-- App 图标 -->
            <ImageView
                android:id="@+id/splash_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:contentDescription="logo"
                android:src="@mipmap/icon_background" />

        </FrameLayout>

        <!-- App 名称 -->
        <TextView
            android:id="@+id/splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:alpha="0"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.2"
            android:text="BICYCLE"
            android:textColor="#E0FFFFFF"
            android:textSize="24sp" />

        <!-- 分隔线 -->
        <View
            android:id="@+id/splash_divider"
            android:layout_width="48dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:alpha="0"
            android:background="@drawable/splash_line_gradient" />

        <!-- 副标题 -->
        <TextView
            android:id="@+id/splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0"
            android:letterSpacing="0.05"
            android:text="智能骑行助手"
            android:textColor="#60FFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- 底部版本信息 -->
    <TextView
        android:id="@+id/splash_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:alpha="0"
        android:letterSpacing="0.05"
        android:text="v1.0.0"
        android:textColor="#30FFFFFF"
        android:textSize="11sp" />

</FrameLayout>
