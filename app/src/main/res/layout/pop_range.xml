<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="to"
        android:textSize="20sp"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="zone 1"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:layout_marginBottom="30px"
        app:layout_constraintBottom_toTopOf="@+id/picker_right"
        app:layout_constraintEnd_toEndOf="@+id/picker_right"
        app:layout_constraintStart_toStartOf="@+id/picker_left" />

    <NumberPicker
        android:id="@+id/picker_left"
        android:layout_width="150px"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/textView"
        app:layout_constraintEnd_toStartOf="@+id/textView"
        app:layout_constraintTop_toTopOf="@+id/textView"
        android:layout_marginEnd="30px"/>

    <NumberPicker
        android:id="@+id/picker_right"
        android:layout_width="150px"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/textView"
        app:layout_constraintStart_toEndOf="@+id/textView"
        app:layout_constraintTop_toTopOf="@+id/textView"
        android:layout_marginStart="30px"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/picker_left">

        <Button
            android:id="@+id/cancal"
            android:layout_width="0dp"
            android:layout_height="200px"
            android:layout_weight="1"
            android:background="#00000000"
            android:text="Cancel"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/ok"
            android:layout_width="0dp"
            android:layout_height="200px"
            android:layout_weight="1"
            android:background="#00000000"
            android:text="Ok"
            android:textColor="@color/black" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>