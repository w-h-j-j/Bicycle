<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 背景轨道 -->
    <item>
        <shape android:shape="line">
            <stroke
                android:width="3dp"
                android:color="#1AFFFFFF" />
        </shape>
    </item>
    <!-- 进度条 -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="line">
                <stroke
                    android:width="3dp"
                    android:color="#FFFFFF" />
            </shape>
        </clip>
    </item>
</layer-list>