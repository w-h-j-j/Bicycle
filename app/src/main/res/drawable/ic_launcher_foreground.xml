<?xml version="1.0" encoding="utf-8"?>
<!-- 兼容 API 23 的前景层（与 drawable-v24 相同内容） -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 后轮 -->
    <path
        android:strokeColor="#7AA2F7"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:pathData="M38,70m-11.5,0a11.5,11.5 0 1,0 23,0a11.5,11.5 0 1,0 -23,0z" />

    <!-- 前轮 -->
    <path
        android:strokeColor="#7AA2F7"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:pathData="M70,70m-11.5,0a11.5,11.5 0 1,0 23,0a11.5,11.5 0 1,0 -23,0z" />

    <!-- 车架：后轴→车座上端→首管，五通→首管，五通→后轴 -->
    <path
        android:strokeColor="#7DCFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M38,70L49,44M54,66L49,44M54,66L66,44M70,70L66,44" />

    <!-- 上管：车座→首管 -->
    <path
        android:strokeColor="#7DCFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:pathData="M49,44L66,44" />

    <!-- 车座 -->
    <path
        android:strokeColor="#7DCFFF"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:pathData="M44.5,40.5L53,40.5" />

    <!-- 车把 -->
    <path
        android:strokeColor="#7DCFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:pathData="M66,44L68,37M64,37L72,37" />

    <!-- 牙盘 -->
    <path
        android:strokeColor="#7DCFFF"
        android:strokeWidth="2.4"
        android:pathData="M54,66m-3.4,0a3.4,3.4 0 1,0 6.8,0a3.4,3.4 0 1,0 -6.8,0z" />

    <!-- 绿色数据上载箭头：杆 + 头部 -->
    <path
        android:strokeColor="#9ECE6A"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M80,32L80,20M74.5,25.5L80,20L85.5,25.5" />

</vector>
